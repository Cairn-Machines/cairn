{
  "prChecks": {
    "ignore": [
      "notify"
    ]
  },
  "setup": [
    "npm ci"
  ],
  "quickChecks": [
    "npm run typecheck",
    "npm run lint"
  ],
  "checks": [
    "npm run typecheck",
    "npm run lint",
    "npm test",
    "npm run build",
    "npm run test:integration:local"
  ],
  "e2eSmoke": [
    "npm run test:smoke"
  ],
  "release": {
    "versionFiles": [
      {
        "path": "package.json",
        "pointers": [
          "/version"
        ]
      },
      {
        "path": "package-lock.json",
        "pointers": [
          "/version",
          "/packages//version"
        ]
      }
    ]
  }
}
